{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-newapi-gateway.schema.json",
  "title": "Codex NewAPI Gateway Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services",
    "api_keys"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_url",
          "keys",
          "disabled",
          "priority",
          "models"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "api_key",
                "disabled",
                "priority"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "api_key": {
                  "type": "string",
                  "minLength": 1
                },
                "disabled": {
                  "type": "boolean"
                },
                "priority": {
                  "type": "integer"
                }
              }
            }
          },
          "disabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supports_websocket": {
            "type": "boolean",
            "default": false
          },
          "supports_web_search": {
            "type": "boolean",
            "default": false
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status_codes",
              "delays_ms"
            ],
            "properties": {
              "status_codes": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 400,
                  "maximum": 599
                }
              },
              "delays_ms": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "status_codes": { "minItems": 1 },
                  "delays_ms": { "minItems": 1 }
                }
              },
              {
                "properties": {
                  "status_codes": { "maxItems": 0 },
                  "delays_ms": { "maxItems": 0 }
                }
              }
            ]
          }
        }
      }
    },
    "api_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "api_key",
          "services"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "model_routes": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "web_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["proxy", "tavily", "exa"],
          "default": "proxy"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "api_key": {
          "type": "string",
          "minLength": 1
        },
        "max_results": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "proxy" } },
            "required": ["mode"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["base_url"] },
                { "required": ["api_key"] },
                { "required": ["max_results"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "enum": ["tavily", "exa"] } },
            "required": ["mode"]
          },
          "then": { "required": ["api_key"] }
        },
        {
          "if": {
            "properties": { "mode": { "const": "tavily" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "max_results": {
                "minimum": 0,
                "maximum": 20,
                "default": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "exa" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "max_results": {
                "minimum": 1,
                "maximum": 100,
                "default": 10
              }
            }
          }
        }
      ]
    }
  }
}
