{
  "$schema": "./config.schema.json",
  "services": [
    {
      "id": "newapi-primary",
      "base_url": "https://primary.example.com/v1",
      "keys": [
        {
          "id": "primary-key",
          "api_key": "sk-upstream-primary",
          "disabled": false,
          "priority": 100
        },
        {
          "id": "backup-key",
          "api_key": "sk-upstream-primary-backup",
          "disabled": true,
          "priority": 50
        }
      ],
      "disabled": false,
      "priority": 100,
      "supports_websocket": true,
      "supports_web_search": true,
      "models": ["grok-4.5", "gpt-4.1", "gpt-image-2"],
      "retry": {
        "status_codes": [429],
        "delays_ms": [250, 500, 1000]
      }
    },
    {
      "id": "newapi-secondary",
      "base_url": "https://secondary.example.com/v1",
      "keys": [
        {
          "id": "default-key",
          "api_key": "sk-upstream-secondary",
          "disabled": false,
          "priority": 100
        }
      ],
      "disabled": false,
      "priority": 50,
      "supports_websocket": false,
      "supports_web_search": false,
      "models": ["grok-4.5"],
      "retry": {
        "status_codes": [429],
        "delays_ms": [1000]
      }
    }
  ],
  "api_keys": [
    {
      "id": "client-a",
      "api_key": "sk-gateway-client-a",
      "services": ["newapi-primary", "newapi-secondary"]
    },
    {
      "id": "client-b",
      "api_key": "sk-gateway-client-b",
      "services": ["newapi-secondary"]
    }
  ],
  "model_routes": {
    "gpt-5.6-sol": {
      "model": "grok-4.5"
    },
    "codex-auto-review": {
      "model": "gpt-4.1",
      "services": ["newapi-primary"]
    }
  }
}
